{
  "openapi": "3.0.3",
  "info": {
    "title": "Conflux",
    "version": "0.5.0",
    "description": "Read-only API for roles, people, teams, services, and components."
  },
  "servers": [
    {
      "url": "https://localhost/api/v1/",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Role",
      "description": "Operations related to Roles."
    },
    {
      "name": "Person",
      "description": "Operations related to People."
    },
    {
      "name": "Team",
      "description": "Operations related to Teams."
    }
  ],
  "paths": {
    "/roles": {
      "get": {
        "summary": "List roles",
        "description": "Returns a list of roles in the organisation, optionally filtered and sorted.",
        "operationId": "listRoles",
        "tags": ["Role"],
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "Field to sort roles by.",
            "schema": {
              "type": "string",
              "enum": ["name", "grade", "updated"],
              "default": "name"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter roles by status.",
            "schema": {
              "type": "string",
              "enum": ["active", "archived", "all"],
              "default": "active"
            }
          },
          {
            "name": "profession",
            "in": "query",
            "description": "Filter roles by exact profession. Omit this parameter to include all professions, including unassigned roles.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for paginated results.",
            "schema": {
              "type": "integer",
              "default": "1"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Number of results per page for paginated results..",
            "schema": {
              "type": "integer",
              "default": "25"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of roles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RoleNested"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/roles/{id}": {
      "get": {
        "summary": "Get a role by ID",
        "description": "Returns detailed information about a specific role.",
        "operationId": "getRole",
        "tags": ["Role"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the role.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Role details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Role"
                }
              }
            }
          },
          "404": {
            "description": "Role not found"
          }
        }
      }
    },
    "/people": {
      "get": {
        "summary": "List people",
        "description": "Returns a list of people in the organisation, optionally filtered and sorted.",
        "operationId": "listPeople",
        "tags": ["Person"],
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "Field to sort people by.",
            "schema": {
              "type": "string",
              "enum": ["name", "location", "employment_type", "updated"],
              "default": "name"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter people by status.",
            "schema": {
              "type": "string",
              "enum": ["active", "archived", "all"],
              "default": "active"
            }
          },
          {
            "name": "employment_type",
            "in": "query",
            "description": "Filter people by employment type.",
            "schema": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": ["all"]
                },
                {
                  "$ref": "#/components/schemas/EmploymentType"
                }
              ],
              "default": "all"
            }
          },
          {
            "name": "profession",
            "in": "query",
            "description": "Filter people by their assigned role's profession.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for paginated results.",
            "schema": {
              "type": "integer",
              "default": "1"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Number of results per page for paginated results..",
            "schema": {
              "type": "integer",
              "default": "25"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of people",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PersonNested"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/people/{id}": {
      "get": {
        "summary": "Get a person by ID",
        "description": "Returns detailed information about a specific person.",
        "operationId": "getPerson",
        "tags": ["Person"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the person.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Person details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Person"
                }
              }
            }
          },
          "404": {
            "description": "Person not found"
          }
        }
      }
    },
    "/teams": {
      "get": {
        "summary": "List teams",
        "description": "Returns a list of teams in the organisation, optionally filtered and sorted.",
        "operationId": "listTeams",
        "tags": ["Team"],
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "Field to sort teams by.",
            "schema": {
              "type": "string",
              "enum": ["name", "updated"],
              "default": "name"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter teams by status.",
            "schema": {
              "type": "string",
              "enum": ["active", "archived", "all"],
              "default": "active"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for paginated results.",
            "schema": {
              "type": "integer",
              "default": "1"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Number of results per page for paginated results..",
            "schema": {
              "type": "integer",
              "default": "25"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of teams",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TeamNested"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/teams/{id}": {
      "get": {
        "summary": "Get a team by ID",
        "description": "Returns detailed information about a specific team.",
        "operationId": "getTeam",
        "tags": ["Team"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the team.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Team details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Team"
                }
              }
            }
          },
          "404": {
            "description": "Team not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Grade": {
        "type": "string",
        "description": "Civil Service grade associated with a role.",
        "enum": [
          "AA",
          "AO",
          "EO",
          "HEO",
          "SEO",
          "SEO+",
          "G7",
          "G6",
          "SCS1",
          "SCS2"
        ],
        "example": "SEO"
      },
      "Location": {
        "type": "string",
        "description": "Office location where a person is based.",
        "enum": [
          "Birkenhead",
          "Coventry",
          "Croydon",
          "Durham",
          "Fylde",
          "Gloucester",
          "Hull",
          "Leicester",
          "Nottingham",
          "Peterborough",
          "Plymouth",
          "Swansea",
          "Telford",
          "Weymouth"
        ],
        "example": "Plymouth"
      },
      "EmploymentType": {
        "type": "string",
        "description": "Employment type of a person.",
        "enum": ["permanent", "contractor"],
        "example": "permanent"
      },
      "PersonNested": {
        "type": "object",
        "description": "A lightweight representation of a person.",
        "required": ["id", "name", "email_address", "location", "employment_type", "updated_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the person."
          },
          "name": {
            "type": "string",
            "description": "Full name of the person.",
            "example": "John Appleseed"
          },
          "email_address": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "description": "Email address of the person.",
            "example": "john.appleseed@example.com"
          },
          "location": {
            "description": "Office location of the person.",
            "$ref": "#/components/schemas/Location"
          },
          "employment_type": {
            "description": "Employment type of the person.",
            "$ref": "#/components/schemas/EmploymentType"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the person was last updated."
          }
        }
      },
      "RoleNested": {
        "type": "object",
        "description": "A lightweight representation of a role.",
        "required": ["id", "name", "grade", "updated_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the role."
          },
          "name": {
            "type": "string",
            "description": "Name of the role.",
            "example": "Senior Software Developer"
          },
          "grade": {
            "description": "Grade associated with the role.",
            "$ref": "#/components/schemas/Grade"
          },
          "profession": {
            "type": "string",
            "nullable": true,
            "description": "Profession associated with the role, if assigned."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the role was last updated."
          }
        }
      },
      "TeamNested": {
        "type": "object",
        "description": "A lightweight representation of a team.",
        "required": ["id", "name", "updated_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the team."
          },
          "name": {
            "type": "string",
            "description": "Display name of the team.",
            "example": "Byte Club"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the team was last updated."
          }
        }
      },
      "ServiceNested": {
        "type": "object",
        "description": "A lightweight representation of a service.",
        "required": ["id", "name", "updated_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the service."
          },
          "name": {
            "type": "string",
            "description": "Display name of the service.",
            "example": "Case Management"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the service was last updated."
          }
        }
      },
      "Person": {
        "type": "object",
        "description": "Detailed representation of a person.",
        "required": ["id", "name", "email_address", "location", "employment_type", "updated_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the person."
          },
          "name": {
            "type": "string",
            "description": "Full name of the person.",
            "example": "John Appleseed"
          },
          "email_address": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "description": "Email address of the person.",
            "example": "john.appleseed@example.com"
          },
          "location": {
            "description": "Office location of the person.",
            "$ref": "#/components/schemas/Location"
          },
          "employment_type": {
            "description": "Employment type of the person.",
            "$ref": "#/components/schemas/EmploymentType"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the person was last updated."
          },
          "archived_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Timestamp when the person was archived, if applicable."
          },
          "role": {
            "description": "Role performed by the person.",
            "$ref": "#/components/schemas/RoleNested"
          },
          "team": {
            "description": "Team the person belongs to.",
            "$ref": "#/components/schemas/TeamNested"
          },
          "manager": {
            "description": "Manager of the person.",
            "$ref": "#/components/schemas/PersonNested"
          },
          "reports": {
            "type": "array",
            "description": "People who report to this person.",
            "items": {
              "$ref": "#/components/schemas/PersonNested"
            }
          }
        }
      },
      "Role": {
        "type": "object",
        "description": "Detailed representation of a role.",
        "required": ["id", "name", "grade", "updated_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the role."
          },
          "name": {
            "type": "string",
            "description": "Name of the role.",
            "example": "Senior Software Developer"
          },
          "grade": {
            "description": "Grade associated with the role.",
            "$ref": "#/components/schemas/Grade"
          },
          "profession": {
            "type": "string",
            "nullable": true,
            "description": "Profession associated with the role, if assigned."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the role was last updated."
          },
          "people": {
            "type": "array",
            "description": "People assigned to this role.",
            "items": {
              "$ref": "#/components/schemas/PersonNested"
            }
          }
        }
      },
      "Team": {
        "type": "object",
        "description": "Detailed representation of a team.",
        "required": ["id", "name", "updated_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the team."
          },
          "name": {
            "type": "string",
            "description": "Display name of the team.",
            "example": "Byte Club"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the team was last updated."
          },
          "people": {
            "type": "array",
            "description": "People assigned to this team.",
            "items": {
              "$ref": "#/components/schemas/PersonNested"
            }
          },
          "services": {
            "type": "array",
            "description": "Services owned by this team.",
            "items": {
              "$ref": "#/components/schemas/ServiceNested"
            }
          }
        }
      }
    }
  }
}
