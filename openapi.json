{
  "openapi": "3.2.0",
  "info": {
    "title": "Conflux",
    "version": "0.14.0",
    "description": "Read-only API for roles, people, teams, and services."
  },
  "servers": [
    {
      "name": "Local development",
      "url": "https://localhost/api/v1",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Role",
      "summary": "Roles",
      "kind": "nav",
      "description": "Operations related to Roles."
    },
    {
      "name": "Person",
      "summary": "People",
      "kind": "nav",
      "description": "Operations related to People."
    },
    {
      "name": "Team",
      "summary": "Teams",
      "kind": "nav",
      "description": "Operations related to Teams."
    },
    {
      "name": "Service",
      "summary": "Services",
      "kind": "nav",
      "description": "Operations related to Services."
    }
  ],
  "paths": {
    "/roles/": {
      "get": {
        "summary": "List roles",
        "description": "Returns a list of roles in the organisation, optionally filtered and sorted.",
        "operationId": "listRoles",
        "tags": ["Role"],
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "Field to sort roles by.",
            "schema": {
              "type": "string",
              "enum": ["name", "grade", "profession", "updated"],
              "default": "name"
            }
          },
          {
            "$ref": "#/components/parameters/Status"
          },
          {
            "name": "profession",
            "in": "query",
            "description": "Filter roles by exact profession. Omit this parameter to include all professions, including unassigned roles.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          }
        ],
        "responses": {
          "200": {
            "description": "List of roles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RoleNested"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/DatabaseError"
          }
        }
      }
    },
    "/roles/{id}": {
      "get": {
        "summary": "Get a role by ID",
        "description": "Returns detailed information about a specific role.",
        "operationId": "getRole",
        "tags": ["Role"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the role.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Role details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Role"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/DatabaseError"
          }
        }
      }
    },
    "/people/": {
      "get": {
        "summary": "List people",
        "description": "Returns a list of people in the organisation, optionally filtered and sorted.",
        "operationId": "listPeople",
        "tags": ["Person"],
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "Field to sort people by.",
            "schema": {
              "type": "string",
              "enum": ["name", "location", "employment", "updated"],
              "default": "name"
            }
          },
          {
            "$ref": "#/components/parameters/Status"
          },
          {
            "name": "employment",
            "in": "query",
            "description": "Filter people by employment type.",
            "schema": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": ["all"]
                },
                {
                  "$ref": "#/components/schemas/EmploymentType"
                }
              ],
              "default": "all"
            }
          },
          {
            "name": "profession",
            "in": "query",
            "description": "Filter people by their assigned role's profession.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          }
        ],
        "responses": {
          "200": {
            "description": "List of people",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PersonNested"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/DatabaseError"
          }
        }
      }
    },
    "/people/{id}": {
      "get": {
        "summary": "Get a person by ID",
        "description": "Returns detailed information about a specific person.",
        "operationId": "getPerson",
        "tags": ["Person"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the person.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Person details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Person"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/DatabaseError"
          }
        }
      }
    },
    "/teams/": {
      "get": {
        "summary": "List teams",
        "description": "Returns a list of teams in the organisation, optionally filtered and sorted.",
        "operationId": "listTeams",
        "tags": ["Team"],
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "Field to sort teams by.",
            "schema": {
              "type": "string",
              "enum": ["name", "updated"],
              "default": "name"
            }
          },
          {
            "$ref": "#/components/parameters/Status"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          }
        ],
        "responses": {
          "200": {
            "description": "List of teams",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TeamNested"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/DatabaseError"
          }
        }
      }
    },
    "/teams/{id}": {
      "get": {
        "summary": "Get a team by ID",
        "description": "Returns detailed information about a specific team.",
        "operationId": "getTeam",
        "tags": ["Team"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the team.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Team details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Team"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/DatabaseError"
          }
        }
      }
    },
    "/services/": {
      "get": {
        "summary": "List services",
        "description": "Returns a list of services in the organisation, optionally filtered and sorted.",
        "operationId": "listServices",
        "tags": ["Service"],
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "Field to sort services by.",
            "schema": {
              "type": "string",
              "enum": ["name", "updated"],
              "default": "name"
            }
          },
          {
            "$ref": "#/components/parameters/Status"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          }
        ],
        "responses": {
          "200": {
            "description": "List of services",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ServiceNested"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/DatabaseError"
          }
        }
      }
    },
    "/services/{id}": {
      "get": {
        "summary": "Get a service by ID",
        "description": "Returns detailed information about a specific service.",
        "operationId": "getService",
        "tags": ["Service"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the service.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Service details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Service"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/DatabaseError"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Status": {
        "name": "status",
        "in": "query",
        "description": "Filter records by status.",
        "schema": {
          "type": "string",
          "enum": ["active", "archived", "all"],
          "default": "active"
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "description": "Page number for paginated results.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "description": "Number of results per page. Values below 1 are treated as 20.",
        "schema": {
          "type": "integer",
          "default": 25
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "The requested resource or page was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "DatabaseError": {
        "description": "A database error occurred.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message."
          }
        }
      },
      "Grade": {
        "type": "string",
        "description": "Civil Service grade associated with a role. Values are configured per deployment.",
        "examples": ["SEO"]
      },
      "Location": {
        "type": "string",
        "description": "Office location where a person is based. Values are configured per deployment.",
        "examples": ["Plymouth"]
      },
      "EmploymentType": {
        "type": "string",
        "description": "Employment type of a person.",
        "enum": ["employee", "contractor"],
        "examples": ["employee"]
      },
      "PersonNested": {
        "type": "object",
        "description": "A lightweight representation of a person.",
        "required": [
          "id",
          "name",
          "email_address",
          "location",
          "employment",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the person."
          },
          "name": {
            "type": "string",
            "description": "Full name of the person.",
            "examples": ["John Appleseed"]
          },
          "email_address": {
            "type": ["string", "null"],
            "format": "email",
            "description": "Email address of the person.",
            "examples": ["john.appleseed@example.com"]
          },
          "location": {
            "description": "Office location of the person.",
            "$ref": "#/components/schemas/Location"
          },
          "employment": {
            "description": "Employment type of the person.",
            "$ref": "#/components/schemas/EmploymentType"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the person was last updated."
          },
          "archived_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the person was archived; omitted for active people."
          }
        }
      },
      "RoleNested": {
        "type": "object",
        "description": "A lightweight representation of a role.",
        "required": ["id", "name", "grade", "profession", "updated_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the role."
          },
          "name": {
            "type": "string",
            "description": "Name of the role.",
            "examples": ["Senior Software Developer"]
          },
          "grade": {
            "description": "Grade associated with the role.",
            "$ref": "#/components/schemas/Grade"
          },
          "profession": {
            "type": ["string", "null"],
            "description": "Profession associated with the role. This can be null for roles created before a profession was required."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the role was last updated."
          },
          "archived_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the role was archived; omitted for active roles."
          }
        }
      },
      "TeamNested": {
        "type": "object",
        "description": "A lightweight representation of a team.",
        "required": ["id", "name", "updated_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the team."
          },
          "name": {
            "type": "string",
            "description": "Display name of the team.",
            "examples": ["Byte Club"]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the team was last updated."
          },
          "archived_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the team was archived; omitted for active teams."
          }
        }
      },
      "ServiceNested": {
        "type": "object",
        "description": "A lightweight representation of a service.",
        "required": ["id", "name", "description", "updated_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the service."
          },
          "name": {
            "type": "string",
            "description": "Display name of the service.",
            "examples": ["Case Management"]
          },
          "description": {
            "type": ["string", "null"],
            "description": "Description of the service."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the service was last updated."
          },
          "archived_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the service was archived; omitted for active services."
          }
        }
      },
      "Person": {
        "type": "object",
        "description": "Detailed representation of a person.",
        "required": [
          "id",
          "name",
          "email_address",
          "location",
          "employment",
          "updated_at",
          "reports"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the person."
          },
          "name": {
            "type": "string",
            "description": "Full name of the person.",
            "examples": ["John Appleseed"]
          },
          "email_address": {
            "type": ["string", "null"],
            "format": "email",
            "description": "Email address of the person.",
            "examples": ["john.appleseed@example.com"]
          },
          "location": {
            "description": "Office location of the person.",
            "$ref": "#/components/schemas/Location"
          },
          "employment": {
            "description": "Employment type of the person.",
            "$ref": "#/components/schemas/EmploymentType"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the person was last updated."
          },
          "archived_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the person was archived; omitted for active people."
          },
          "role": {
            "description": "Role performed by the person.",
            "$ref": "#/components/schemas/RoleNested"
          },
          "team": {
            "description": "Team the person belongs to.",
            "$ref": "#/components/schemas/TeamNested"
          },
          "manager": {
            "description": "Manager of the person.",
            "$ref": "#/components/schemas/PersonNested"
          },
          "reports": {
            "type": "array",
            "description": "People who report to this person.",
            "items": {
              "$ref": "#/components/schemas/PersonNested"
            }
          }
        }
      },
      "Role": {
        "type": "object",
        "description": "Detailed representation of a role.",
        "required": [
          "id",
          "name",
          "grade",
          "profession",
          "updated_at",
          "people"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the role."
          },
          "name": {
            "type": "string",
            "description": "Name of the role.",
            "examples": ["Senior Software Developer"]
          },
          "grade": {
            "description": "Grade associated with the role.",
            "$ref": "#/components/schemas/Grade"
          },
          "profession": {
            "type": ["string", "null"],
            "description": "Profession associated with the role. This can be null for roles created before a profession was required."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the role was last updated."
          },
          "archived_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the role was archived; omitted for active roles."
          },
          "people": {
            "type": "array",
            "description": "People assigned to this role.",
            "items": {
              "$ref": "#/components/schemas/PersonNested"
            }
          }
        }
      },
      "Team": {
        "type": "object",
        "description": "Detailed representation of a team.",
        "required": ["id", "name", "updated_at", "people", "services"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the team."
          },
          "name": {
            "type": "string",
            "description": "Display name of the team.",
            "examples": ["Byte Club"]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the team was last updated."
          },
          "archived_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the team was archived; omitted for active teams."
          },
          "people": {
            "type": "array",
            "description": "People assigned to this team.",
            "items": {
              "$ref": "#/components/schemas/PersonNested"
            }
          },
          "services": {
            "type": "array",
            "description": "Services owned by this team.",
            "items": {
              "$ref": "#/components/schemas/ServiceNested"
            }
          }
        }
      },
      "Service": {
        "type": "object",
        "description": "Detailed representation of a service.",
        "required": ["id", "name", "description", "updated_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the service."
          },
          "name": {
            "type": "string",
            "description": "Display name of the service.",
            "examples": ["Case Management"]
          },
          "description": {
            "type": ["string", "null"],
            "description": "Description of the service."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the service was last updated."
          },
          "archived_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the service was archived; omitted for active services."
          },
          "team": {
            "description": "Team that owns the service. Omitted when the service has no team.",
            "$ref": "#/components/schemas/TeamNested"
          }
        }
      }
    }
  }
}
