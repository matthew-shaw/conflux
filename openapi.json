{
  "openapi": "3.0.3",
  "info": {
    "title": "Conflux",
    "version": "0.3.0",
    "description": "Read-only API for roles, people, teams, services, and components."
  },
  "servers": [
    {
      "url": "https://localhost/api/v1/",
      "description": "Local"
    }
  ],
  "paths": {
    "/roles": {
      "get": {
        "summary": "List roles",
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["name", "grade", "updated"],
              "default": "name"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["active", "archived", "all"],
              "default": "active"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of roles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RoleNested"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/roles/{id}": {
      "get": {
        "summary": "Get a role by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Role details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Role"
                }
              }
            }
          },
          "404": {
            "description": "Role not found"
          }
        }
      }
    },
    "/people": {
      "get": {
        "summary": "List people",
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["name", "location", "updated"],
              "default": "name"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["active", "archived", "all"],
              "default": "active"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of people",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PersonNested"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/people/{id}": {
      "get": {
        "summary": "Get a person by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Person details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Person"
                }
              }
            }
          },
          "404": {
            "description": "Person not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Grade": {
        "type": "string",
        "enum": [
          "AA",
          "AO",
          "EO",
          "HEO",
          "SEO",
          "SEO+",
          "G7",
          "G6",
          "SCS1",
          "SCS2"
        ],
        "example": "SEO"
      },
      "Location": {
        "type": "string",
        "enum": [
          "Birkenhead",
          "Coventry",
          "Croydon",
          "Durham",
          "Fylde",
          "Gloucester",
          "Hull",
          "Leicester",
          "Nottingham",
          "Peterborough",
          "Plymouth",
          "Swansea",
          "Telford",
          "Weymouth"
        ],
        "example": "Plymouth"
      },
      "PersonNested": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "John Appleseed"
          },
          "email_address": {
            "type": "string",
            "format": "email",
            "example": "john.appleseed@example.com"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RoleNested": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Senior Software Developer"
          },
          "grade": {
            "$ref": "#/components/schemas/Grade"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TeamNested": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Byte Club"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Person": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "John Appleseed"
          },
          "email_address": {
            "type": "string",
            "format": "email",
            "example": "john.appleseed@example.com"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "archived_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "role": {
            "$ref": "#/components/schemas/RoleNested"
          },
          "team": {
            "$ref": "#/components/schemas/TeamNested"
          },
          "manager": {
            "$ref": "#/components/schemas/PersonNested"
          },
          "reports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonNested"
            }
          }
        }
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Senior Software Developer"
          },
          "grade": {
            "$ref": "#/components/schemas/Grade"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "people": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonNested"
            }
          }
        }
      }
    }
  }
}
