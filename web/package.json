{
  "name": "conflux",
  "version": "1.0.0",
  "description": "Conflux",
  "private": true,
  "scripts": {
    "format:check": "prettier src --check",
    "format:fix": "prettier src --write",
    "lint:check": "eslint src",
    "lint:fix": "eslint src --fix",
    "prebuild": "npm run format:check && npm run lint:check",
    "build": "webpack",
    "watch": "webpack --watch",
    "upgrade:latest": "ncu -u",
    "upgrade:minor": "ncu -t minor -u",
    "upgrade:patch": "ncu -t patch -u"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthew-shaw/conflux.git"
  },
  "author": {
    "name": "Matt Shaw",
    "url": "https://matthew-shaw.github.io/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/matthew-shaw/conflux/issues"
  },
  "homepage": "https://github.com/matthew-shaw/conflux#readme",
  "dependencies": {
    "govuk-frontend": "6.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "mini-css-extract-plugin": "^2.10.0",
    "npm-check-updates": "^19.6.3",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.2.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1"
  }
}
